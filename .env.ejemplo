# Plantilla de configuracion local. Copiar como .env y completar.
#
#   copy .env.ejemplo .env        (Windows)
#   cp .env.ejemplo .env          (bash)
#
# El .env NO se versiona: cada integrante pone su propia clave.
# Detalles en docs/chat.md

# Cual proveedor usa el chat: "gemini" o "claude".
# Si se deja vacio, se usa el que tenga clave configurada.
AGENTE_LLM=gemini

# ---- Gemini (tiene nivel gratuito) ----
# Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Conviene un modelo concreto y no un alias -latest: los alias apuntan al mas
# popular y se saturan. Si el modelo configurado no existe para la clave, el
# chat lo avisa y lista los disponibles.
GEMINI_MODEL=gemini-3.5-flash

# Respaldo cuando el principal devuelve 503 por saturacion. Se reintenta una
# vez y la respuesta avisa que la contesto el respaldo.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

